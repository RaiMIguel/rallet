rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function signedInWithEmail() {
        return request.auth != null && request.auth.token.email != null;
      }

      function ownsEmail(email) {
        return signedInWithEmail() && email == request.auth.token.email;
      }

      allow read: if ownsEmail(resource.data.email);
      allow create: if ownsEmail(request.resource.data.email);
      allow update: if ownsEmail(resource.data.email)
                    && ownsEmail(request.resource.data.email);
      allow delete: if ownsEmail(resource.data.email);
    }
  }
}
